SOCCER_ORACLE_BASE_URL=https://soccer-oracle-api-dev.up.railway.app
TENNIS_ORACLE_BASE_URL=https://tennisoracle-backend-dev.up.railway.app

PROVIDER_CONNECT_TIMEOUT=3
PROVIDER_READ_TIMEOUT=15

# true = local fixtures (recommended when Railway providers are down)
# false = call Railway upstreams
USE_PROVIDER_FIXTURES=true

# Tennis auth (required for live Railway; fixtures work without login)
TENNIS_ORACLE_USERNAME=admin
TENNIS_ORACLE_PASSWORD=1234
# Optional static bearer instead of username/password
# TENNIS_ORACLE_BEARER_TOKEN=

# Soccer auth (optional today; reserved for when upstream adds login)
# SOCCER_ORACLE_USERNAME=
# SOCCER_ORACLE_PASSWORD=
# SOCCER_ORACLE_API_KEY=

# Feed / cache
APP_TIMEZONE=Europe/Rome
CACHE_TTL_SECONDS=60
CACHE_STALE_MAX_SECONDS=300
FEED_DEADLINE_SECONDS=10
PROVIDER_MAX_ITEMS=1000
SNAPSHOT_TTL_SECONDS=300

LOG_LEVEL=INFO
