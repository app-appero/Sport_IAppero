SOCCER_ORACLE_BASE_URL=https://soccer-oracle-api-dev.up.railway.app
TENNIS_ORACLE_BASE_URL=https://tennisoracle-backend-dev.up.railway.app

PROVIDER_CONNECT_TIMEOUT=3
PROVIDER_READ_TIMEOUT=8

# When true, providers serve local fixtures (useful if upstream Railway apps are down)
USE_PROVIDER_FIXTURES=false

# Optional — set only if discovery shows auth is required
# SOCCER_ORACLE_API_KEY=
# TENNIS_ORACLE_API_KEY=
# TENNIS_ORACLE_BEARER_TOKEN=

LOG_LEVEL=INFO
