# Sport IApperò BFF base URL (no trailing slash)
# Deployed dev BFF:
EXPO_PUBLIC_API_URL=https://bff-sport-iappero-dev.up.railway.app
# Local BFF:
# EXPO_PUBLIC_API_URL=http://localhost:8000
# Android emulator → host machine:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# Google sign-in (native builds only). The project's Web client ID is already the default in
# services/auth.ts; set this only to override it. Must match GOOGLE_CLIENT_IDS on the BFF.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<id>.apps.googleusercontent.com
# Yellow cards (beta): turn on once the BFF serves GET /api/v1/events/{id}/bookings.
# EXPO_PUBLIC_BOOKINGS_API=1
