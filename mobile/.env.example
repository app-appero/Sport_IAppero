# Sport IApperò BFF base URL (no trailing slash)
# Deployed dev BFF:
EXPO_PUBLIC_API_URL=https://bff-sport-iappero-dev.up.railway.app
# Local BFF:
# EXPO_PUBLIC_API_URL=http://localhost:8000
# Android emulator → host machine:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# Optional Google sign-in (native builds only). Web client ID of your Google Cloud project;
# without it the "Accedi" button is hidden and the app is anonymous-only.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<id>.apps.googleusercontent.com
